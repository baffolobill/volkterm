{
  "id": "my-agent",
  "name": "My Agent",
  "version": "1.0",
  "description": "Teaches VolkTerm the my-agent command: restore, Ask, the phone's chat.",
  "agents": [
    {
      "id": "my-agent",
      "name": "My Agent",
      "programs": ["my-agent"],
      "resume": ["--resume", "{id}"],
      "droppedOptions": ["--resume"],
      "readOnly": ["--read-only"],
      "model": ["--model", "{model}"],
      "transcript": "\"$VOLKTERM_PLUGIN_DIR/transcript.sh\"",
      "conversation": "python3 \"$VOLKTERM_PLUGIN_DIR/chat.py\""
    }
  ]
}
